# Copy this file to .env and replace only the values after =. Never commit .env.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=policypilot

# Low-cost defaults; change OPENAI_CHAT_MODEL to any model enabled for your API account.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-nano
PINECONE_NAMESPACE=policypilot

# These defaults are deliberately conservative for a small API budget.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_RETRIEVAL_SCORE=0.45
# SQLITE_DB_PATH=data/history.db
